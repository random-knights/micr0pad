{
  "pollIntervalMs": 2500,
  "cmdDir": null,
  "focusBrowserOnTalk": false,
  "virtualPad": {
    "enabled": true,
    "onUnplug": false
  },
  "hostedOrigins": [
    "https://rand0m.ai",
    "https://abc-rand0m-ai.web.app"
  ],
  "pairings": [],
  "analytics": {
    "enabled": false
  },
  "watch": {
    "enabled": true,
    "sampleMs": 3000,
    "historyMs": 600000,
    "snoozeMs": 1800000,
    "killable": [
      "chrome.exe",
      "dart.exe",
      "dartvm.exe",
      "java.exe",
      "msedgewebview2.exe"
    ],
    "autoKill": false,
    "rules": {
      "cpuSustained": {
        "enabled": true,
        "cpuPct": 85,
        "forSec": 90
      },
      "memSustained": {
        "enabled": true,
        "memPct": 90,
        "forSec": 60
      },
      "processHog": {
        "enabled": true,
        "workingSetMb": 2048,
        "cpuPct": 50,
        "forSec": 120
      },
      "hungChrome": {
        "enabled": true,
        "name": "chrome.exe",
        "cpuPct": 0,
        "workingSetMb": 800,
        "forSec": 180
      },
      "orphanDev": {
        "enabled": true,
        "names": [
          "dart.exe",
          "dartvm.exe",
          "java.exe"
        ],
        "parents": [
          "code.exe",
          "code - insiders.exe",
          "cursor.exe",
          "windsurf.exe",
          "idea64.exe",
          "studio64.exe",
          "devenv.exe",
          "dart.exe",
          "dartvm.exe",
          "flutter.exe",
          "java.exe",
          "node.exe",
          "cmd.exe",
          "powershell.exe",
          "pwsh.exe",
          "bash.exe",
          "windowsterminal.exe",
          "explorer.exe"
        ],
        "forSec": 300
      }
    }
  },
  "slots": [
    {
      "slot": 0,
      "name": "claude 1",
      "agent": "claude",
      "match": "claude",
      "color": "#ff4124"
    },
    {
      "slot": 1,
      "name": "claude 2",
      "agent": "claude",
      "match": "claude",
      "color": "#7c4dff"
    },
    {
      "slot": 2,
      "name": "codex",
      "agent": "codex",
      "match": "codex",
      "color": "#00b0ff"
    },
    {
      "slot": 3,
      "name": "gemini",
      "agent": "gemini",
      "match": "gemini",
      "color": "#00c853"
    },
    {
      "slot": 4,
      "name": "grok",
      "agent": "grok",
      "match": "grok",
      "color": "#ffa000"
    },
    {
      "slot": 5,
      "name": "huggingface",
      "agent": "hermes",
      "match": "hermes",
      "color": "#90a4ae"
    }
  ],
  "statusColors": {
    "blocked": {
      "color": 16723245,
      "effect": 4,
      "label": "Blocked"
    },
    "working": {
      "color": 8146431,
      "effect": 1,
      "label": "Working"
    },
    "done": {
      "color": 45311,
      "effect": 1,
      "label": "Done"
    },
    "idle": {
      "color": 16765952,
      "effect": 1,
      "label": "Idle"
    },
    "unknown": {
      "color": 9479342,
      "effect": 1,
      "label": "Unknown"
    }
  },
  "underglowPriority": [
    "blocked",
    "working",
    "done",
    "unknown",
    "idle"
  ],
  "underglow": {
    "mode": "auto",
    "color": "#ff4124",
    "effect": 1,
    "animation": "state",
    "brightness": 1,
    "speed": 0.5
  },
  "brightness": 1,
  "speed": 0.5,
